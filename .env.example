# Copy to .env and fill in. Both values come from your browser's x.com cookies.

# auth_token cookie value (required)
X_AUTH_TOKEN=

# ct0 cookie value (required)
X_CT0=

# Optional: raw Cookie header instead of the two values above, e.g.
# X_COOKIE=auth_token=...; ct0=...

# Optional: override the public web bearer token
# X_BEARER=

# Optional: pin a GraphQL query id per operation, e.g.
# X_QUERY_ID_VIEWER=
# X_QUERY_ID_BOOKMARKS=
# X_QUERY_ID_BOOKMARK_FOLDERS_SLICE=
# X_QUERY_ID_BOOKMARK_FOLDER_TIMELINE=

# Safety: folder writes stay disabled unless this is exactly true.
X_ALLOW_WRITES=false

# Safety: hard cap on automated writes per hour (default 30)
X_MAX_WRITES_PER_HOUR=30

# Optional: paste a captured x-client-transaction-id instead of generating one
# X_CLIENT_TRANSACTION_ID=

# cobalt instance used for video/GIF downloads (self-hosted recommended)
COBALT_API_URL=https://api.cobalt.tools
# COBALT_API_KEY=
